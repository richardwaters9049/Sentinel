SENTINEL_ENV=development
SENTINEL_HTTP_ADDR=127.0.0.1:8080
SENTINEL_LOG_LEVEL=info
SENTINEL_DEPENDENCY_TIMEOUT=10s
SENTINEL_SHUTDOWN_TIMEOUT=10s
SENTINEL_READ_HEADER_TIMEOUT=5s

DATABASE_URL=postgres://sentinel:sentinel_dev_only@127.0.0.1:55432/sentinel?sslmode=disable

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_only
POSTGRES_PORT=55432

NATS_URL=nats://127.0.0.1:4222

SENTINEL_BEHAVIOUR_ENABLED=false
SENTINEL_ML_URL=http://127.0.0.1:8090

# Local-only legacy workflow. Non-development environments default to required.
SENTINEL_AUTH_MODE=development
# Required mode: absolute path to a private manifest of hashes and expiring principals.
SENTINEL_AUTH_CREDENTIALS_FILE=

SENTINEL_CONSOLE_ORIGIN=http://127.0.0.1:3000
# Console: required by default in production; development only for local synthetic gates.
SENTINEL_CONSOLE_AUTH_MODE=development
