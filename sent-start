ROOT = Path(__file__).resolve().parent


class StartupError(Exception):
    pass


class TerminalUI:
    """Small terminal renderer; redirected output stays suitable for logs."""
    def __init__(self, *, plain=False, no_animation=False, stream=None):
        self.stream = stream if stream is not None else sys.stdout
        self.interactive = self.stream.isatty() and os.environ.get("TERM") != "dumb" and not plain
        self.colour = self.interactive and "NO_COLOR" not in os.environ
        self.animate = self.interactive and not no_animation
        self.started = time.monotonic()

    def style(self, text, code):
        return f"\033[{code}m{text}\033[0m" if self.colour else text

    def line(self, text=""):
        print(text, file=self.stream, flush=True)

    def banner(self):
        self.line()
        self.line(self.style("Sentinel", "1;96") + self.style("  /  LOCAL LAB", "95"))
        self.line(self.style("Threat hunting · detection · behavioural analytics", "2"))
        self.line()

    def step(self, number, title):
        self.line()
        self.line(self.style(f"[{number}/6]", "95") + " " + self.style(title, "1"))

    def detail(self, label, value):
        self.line(self.style(label + ": ", "2") + self.style(str(value), "96"))

    @contextmanager
    def activity(self, label):
        started = time.monotonic()
        stopped = threading.Event()
        worker = None
        if self.animate:
            def spin():
                frames = ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")
                index = 0
                while not stopped.is_set():
                    width = max(10, shutil.get_terminal_size(fallback=(80, 24)).columns - 16)
                    text = label if len(label) <= width else label[:width - 1] + "…"
                    elapsed = time.monotonic() - started
                    self.stream.write("\r\033[2K" + self.style(frames[index % len(frames)], "96")
                                      + f" {text} " + self.style(f"{elapsed:.1f}s", "2"))
                    self.stream.flush()
                    index += 1
                    stopped.wait(0.08)
            worker = threading.Thread(target=spin, daemon=True)
        outcome, code = "done", "96"
        try:
            if worker:
                worker.start()
            else:
                self.line(self.style("  · ", "95") + label + "…")
            yield
        except BaseException as error:
            outcome, code = ("cancelled", "93") if isinstance(error, KeyboardInterrupt) else ("failed", "91")
            raise
        finally:
            stopped.set()
            if worker:
                worker.join()
                self.stream.write("\r\033[2K")
                self.stream.flush()
            elapsed = time.monotonic() - started
            self.line(self.style(f"  {outcome.upper():<10}", code) + label
                      + self.style(f"  {elapsed:.1f}s", "2"))

    def ready(self, console_url, gateway_url, credentials, run_dir):
        elapsed = time.monotonic() - self.started
        self.line()
        self.line(self.style("READY", "1;96") + self.style(f"  All services online · {elapsed:.1f}s", "2"))
        self.detail("Sentinel is ready", console_url + "/sign-in")
        self.detail("Gateway", gateway_url)
        self.detail("Credential file", credentials["token_file_path"])
        self.detail("Credentials expire", credentials["expires_at"])
        self.detail("Logs", run_dir)
        self.line()
        self.line("Use the analyst credential from that file to sign in.")
        self.line(self.style("Press Ctrl-C to stop the gateway and console.", "95"))
        self.line(self.style("Docker services and data remain available.", "2"))
        self.line()

    def error(self, error):
        colour = self.colour and sys.stderr.isatty()
        prefix = "\033[1;91mFAILED\033[0m" if colour else "FAILED"
        print(f"{prefix}  sent-start: {error}", file=sys.stderr, flush=True)


class Launcher:
    def __init__(self, args):
        self.args = args
        self.ui = TerminalUI(plain=getattr(args, "plain", False),
                             no_animation=getattr(args, "no_animation", False))
        self.children = []
        self.log_handles = []
        self.run_dir = None
        self.console_url = f"http://127.0.0.1:{args.console_port}"
        self.gateway_url = f"http://127.0.0.1:{args.gateway_port}"
        self.compose_command = ["docker", "compose"]

    def run_command(self, command, *, cwd=ROOT, env=None, log_name="startup"):
        labels = {"infrastructure": "Build and start Docker dependencies",
                  "dependencies": "Install locked frontend dependencies",
                  "build": "Compile the gateway"}
        with self.ui.activity(labels.get(log_name, f"Run {command[0]}")):
            child = self.spawn(command, env, log_name, cwd=cwd)
            result = child.wait()
            self.children.remove((log_name, child))
            if result:
                raise StartupError(f"{command[0]} failed. See {self.run_dir / (log_name + '.log')}")

    def spawn(self, command, env, log_name, *, cwd=ROOT):
        log = (self.run_dir / f"{log_name}.log").open("ab")
        self.log_handles.append(log)
        # A separate process group includes Bun/Next child processes during cleanup.
        child = subprocess.Popen(command, cwd=cwd, env=env, stdout=log, stderr=log,
                                 start_new_session=True)
        self.children.append((log_name, child))
        return child

    def check_children(self):
        for name, child in self.children:
            if child.poll() is not None:
                raise StartupError(f"{name} exited unexpectedly. See {self.run_dir / (name + '.log')}")

    def wait_for(self, description, probe, timeout=120):
        with self.ui.activity(f"Wait for {description}"):
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                self.check_children()
                if probe():
                    return
                time.sleep(0.5)
            raise StartupError(f"Timed out waiting for {description}. Logs: {self.run_dir}")

    def cleanup(self):
        # Never stop existing services or remove the PostgreSQL volume.
        groups = [child.pid for _, child in self.children]
        for group in groups:
            try:
                os.killpg(group, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 10
        for _, child in self.children:
            try:
                child.wait(timeout=max(0.1, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                pass
        # A parent may have exited before one of its children; inspect the group too.
        for group in groups:
            try:
                os.killpg(group, 0)
                os.killpg(group, signal.SIGKILL)
            except ProcessLookupError:
                pass
        for _, child in self.children:
            child.wait()
        for log in self.log_handles:
            log.close()

    def select_app_ports(self):
        self.args.console_port = find_available_port(self.args.console_port)
        self.args.gateway_port = find_available_port(self.args.gateway_port,
                                                     exclude={self.args.console_port})
        self.console_url = f"http://127.0.0.1:{self.args.console_port}"
        self.gateway_url = f"http://127.0.0.1:{self.args.gateway_port}"

    def docker_json(self, command):
        result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
        if result.returncode:
            raise StartupError(f"Docker command failed ({command[1]}). Check Docker Desktop.")
        return json.loads(result.stdout)

    def start_infrastructure(self):
        # Locate this checkout's existing project, preserving its database and ports.
        ids = subprocess.run(["docker", "ps", "-aq", "--filter",
                              f"label=com.docker.compose.project.working_dir={ROOT}"],
                             capture_output=True, text=True, check=True).stdout.split()
        containers = self.docker_json(["docker", "inspect", *ids]) if ids else []
        projects = {c["Config"]["Labels"]["com.docker.compose.project"] for c in containers}
        if len(projects) > 1:
            raise StartupError("Multiple Docker projects belong to this checkout; stop the extra project first.")
        project = next(iter(projects), "sentinel-" + hashlib.sha256(str(ROOT).encode()).hexdigest()[:12])
        config = self.docker_json(["docker", "compose", "-p", project, "config", "--format", "json"])
        running = {c["Config"]["Labels"]["com.docker.compose.service"]: c
                   for c in containers if c["State"]["Running"]}
        missing = []
        for name, service in config["services"].items():
            service.pop("container_name", None)
            if name not in running:
                missing.append(name)
            # Docker allocates unused host ports atomically for new/stopped services.
            for port in service.get("ports", []):
                port["host_ip"] = "127.0.0.1"
                port["published"] = "0"
        compose_file = self.run_dir / "compose.json"
        # Resolved environment values may contain dollars; prevent re-interpolation.
        def escape(value):
            if isinstance(value, str):
                return value.replace("$", "$$")
            if isinstance(value, list):
                return [escape(item) for item in value]
            if isinstance(value, dict):
                return {key: escape(item) for key, item in value.items()}
            return value
        compose_file.write_text(json.dumps(escape(config)))
        self.compose_command = ["docker", "compose", "-p", project, "--project-directory",
                                str(ROOT), "-f", str(compose_file)]
        if missing:
            self.run_command(self.compose_command + ["up", "-d", "--build", "--no-deps", *missing],
                             log_name="infrastructure")
        ids = subprocess.run(self.compose_command + ["ps", "-q"], capture_output=True,
                             text=True, check=True).stdout.split()
        if not ids:
            raise StartupError("Docker dependencies did not start.")
        containers = self.docker_json(["docker", "inspect", *ids])
        services = {c["Config"]["Labels"]["com.docker.compose.service"]: c for c in containers}
        def host_port(service, target):
            bindings = services[service]["NetworkSettings"]["Ports"].get(f"{target}/tcp") or []
            if not bindings:
                raise StartupError(f"No published port for {service}.")
            return int(bindings[0]["HostPort"])
        database_port = host_port("postgres", 5432)
        nats_port = host_port("nats", 4222)
        monitor_port = host_port("nats", 8222)
        ml_port = host_port("ml", 8090)
        pg = config["services"]["postgres"]["environment"]
        user = quote(pg["POSTGRES_USER"], safe="")
        password = quote(pg["POSTGRES_PASSWORD"], safe="")
        database = quote(pg["POSTGRES_DB"], safe="")
        self.ui.detail("Docker project", project)
        self.ui.detail("Dependency ports", f"PostgreSQL {database_port} · NATS {nats_port} "
                       f"(monitor {monitor_port}) · ML {ml_port}")
        return {"DATABASE_URL": f"postgres://{user}:{password}@127.0.0.1:{database_port}/{database}?sslmode=disable",
                "NATS_URL": f"nats://127.0.0.1:{nats_port}",
                "NATS_MONITOR_URL": f"http://127.0.0.1:{monitor_port}",
                "SENTINEL_ML_URL": f"http://127.0.0.1:{ml_port}"}

    def start(self):
        self.ui.banner()
        self.ui.step(1, "Check local tools")
        for command in ("docker", "go", "bun"):
            if not shutil.which(command):
                raise StartupError(f"Install {command} before running sent-start.")
        result = subprocess.run(["docker", "compose", "version"], capture_output=True)
        if result.returncode:
            raise StartupError("Docker Compose is unavailable. Install/start Docker Desktop.")
        if self.args.check:
            self.select_app_ports()
            self.ui.line(self.ui.style("Prerequisites found.", "96"))
            self.ui.detail("Console", self.console_url)
            self.ui.detail("Gateway", self.gateway_url)
            return

        os.umask(0o077)
        base = Path.home() / ".local" / "share" / "sentinel" / "runs"
        base.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.run_dir = Path(tempfile.mkdtemp(prefix=datetime.now().strftime("%Y%m%d-%H%M%S-"), dir=base))
        self.ui.detail("Logs", self.run_dir)
        self.ui.step(2, "Prepare Docker dependencies")

        if not docker_ready():
            if sys.platform == "darwin":
                self.ui.line("Opening Docker Desktop…")
                self.run_command(["open", "-a", "Docker"])
            else:
                raise StartupError("Start the Docker daemon, then run sent-start again.")
            self.wait_for("Docker Desktop", docker_ready)

        dependency_env = self.start_infrastructure()
        self.wait_for("PostgreSQL", lambda: postgres_ready(self.compose_command))
        self.wait_for("NATS", lambda: http_ready(dependency_env["NATS_MONITOR_URL"] + "/healthz"))
        self.wait_for("ML service", lambda: http_ready(dependency_env["SENTINEL_ML_URL"] + "/health"))

        self.ui.step(3, "Install dependencies and compile")
        self.run_command(["bun", "install", "--frozen-lockfile"], cwd=ROOT / "apps" / "console", log_name="dependencies")
        binary = self.run_dir / "sentinel-gateway"
        self.run_command(["go", "build", "-o", str(binary), "./cmd/gateway"], cwd=ROOT / "services" / "gateway", log_name="build")

        self.ui.step(4, "Select ports and provision access")
        self.select_app_ports()
        self.ui.detail("Console", self.console_url)
        self.ui.detail("Gateway", self.gateway_url)
        with self.ui.activity("Provision private lab credentials"):
            result = subprocess.run([sys.executable, str(ROOT / "scripts" / "provision-lab-console-auth.py")],
                                    cwd=ROOT, capture_output=True, text=True, check=True)
            credentials = json.loads(result.stdout)
        env = os.environ.copy()
        env.update(dependency_env)
        env.update(SENTINEL_AUTH_MODE="required", SENTINEL_CONSOLE_AUTH_MODE="required",
                   SENTINEL_AUTH_CREDENTIALS_FILE=credentials["manifest_path"],
                   SENTINEL_CONSOLE_ORIGIN=self.console_url,
                   SENTINEL_HTTP_ADDR=f"127.0.0.1:{self.args.gateway_port}",
                   SENTINEL_GATEWAY_URL=self.gateway_url, SENTINEL_BEHAVIOUR_ENABLED="true")
        self.ui.step(5, "Start authenticated gateway")
        self.spawn([str(binary)], env, "gateway")
        self.wait_for("gateway readiness", lambda: http_ready(self.gateway_url + "/ready"))
        self.ui.step(6, "Start analyst console")
        self.spawn(["bun", "run", "dev", "--port", str(self.args.console_port)], env, "console",
                   cwd=ROOT / "apps" / "console")
        self.wait_for("console", lambda: http_ready(self.console_url + "/sign-in"), timeout=180)
        self.ui.ready(self.console_url, self.gateway_url, credentials, self.run_dir)
        if self.args.copy_token:
            if sys.platform != "darwin" or not shutil.which("pbcopy"):
                self.ui.line("Clipboard copying is unavailable; use the credential file.")
            else:
                tokens = json.loads(Path(credentials["token_file_path"]).read_text())
                subprocess.run(["pbcopy"], input=tokens["tokens"]["analyst"], text=True, check=True)
                self.ui.line(self.ui.style("Analyst credential copied to the clipboard; paste it into sign-in.", "96"))
        if not self.args.no_browser:
            webbrowser.open(self.console_url + "/sign-in")
        while True:
            self.check_children()
            time.sleep(1)


def find_available_port(preferred, exclude=()):
    # Try nearby ports, then ask the OS for an ephemeral port.
    candidates = list(range(preferred, min(preferred + 100, 65536))) + [0] * 10
    for candidate in candidates:
        if candidate in exclude:
            continue
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            try:
                sock.bind(("127.0.0.1", candidate))
            except OSError as error:
                if error.errno in (errno.EADDRINUSE, errno.EACCES):
                    continue
                raise
            chosen = sock.getsockname()[1]
            if chosen not in exclude:
                return chosen
    raise StartupError("Could not find an available local port.")


def docker_ready():
    try:
        return subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def postgres_ready(compose_command=None):
    try:
        return subprocess.run((compose_command or ["docker", "compose"]) + ["exec", "-T", "postgres", "sh", "-c",
                               'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'],
                              cwd=ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def http_ready(url):
    try:
        with urlopen(url, timeout=3) as response:
            return response.status == 200
    except (URLError, TimeoutError, OSError):
        return False


def port_number(value):
    port = int(value)
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--no-browser", action="store_true", help="do not open the browser")
    parser.add_argument("--copy-token", action="store_true", help="copy the analyst credential to the macOS clipboard")
    parser.add_argument("--plain", action="store_true", help="disable colour and animation")
    parser.add_argument("--no-animation", action="store_true", help="keep colour but disable progress animation")
    parser.add_argument("--check", action="store_true", help="check prerequisites and ports without starting services")
    parser.add_argument("--console-port", type=port_number, default=3000, help="preferred console port; automatically skips busy ports")
    parser.add_argument("--gateway-port", type=port_number, default=8080, help="preferred gateway port; automatically skips busy ports")
    launcher = Launcher(parser.parse_args())
    def stop(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    try:
        launcher.start()
    except KeyboardInterrupt:
        launcher.ui.line("\n" + launcher.ui.style("Stopping Sentinel…", "93"))
    except (StartupError, subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
        launcher.ui.error(error)
        return 1
    finally:
        if launcher.children:
            with launcher.ui.activity("Stop launched processes"):
                launcher.cleanup()
        else:
            launcher.cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
