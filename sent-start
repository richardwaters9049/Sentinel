#!/usr/bin/env python3
"""Start the authenticated Sentinel lab and supervise its local processes."""
import argparse
from datetime import datetime
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
from urllib.error import URLError
from urllib.request import urlopen
import webbrowser

ROOT = Path(__file__).resolve().parent


class StartupError(Exception):
    pass


class Launcher:
    def __init__(self, args):
        self.args = args
        self.children = []
        self.log_handles = []
        self.run_dir = None
        self.console_url = f"http://127.0.0.1:{args.console_port}"
        self.gateway_url = f"http://127.0.0.1:{args.gateway_port}"

    def run_command(self, command, *, cwd=ROOT, env=None, log_name="startup"):
        child = self.spawn(command, env, log_name, cwd=cwd)
        result = child.wait()
        self.children.remove((log_name, child))
        if result:
            raise StartupError(f"{command[0]} failed. See {self.run_dir / (log_name + '.log')}")

    def spawn(self, command, env, log_name, *, cwd=ROOT):
        log = (self.run_dir / f"{log_name}.log").open("ab")
        self.log_handles.append(log)
        # A separate process group includes Bun/Next child processes during cleanup.
        child = subprocess.Popen(command, cwd=cwd, env=env, stdout=log, stderr=log,
                                 start_new_session=True)
        self.children.append((log_name, child))
        return child

    def check_children(self):
        for name, child in self.children:
            if child.poll() is not None:
                raise StartupError(f"{name} exited unexpectedly. See {self.run_dir / (name + '.log')}")

    def wait_for(self, description, probe, timeout=120):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            self.check_children()
            if probe():
                return
            time.sleep(0.5)
        raise StartupError(f"Timed out waiting for {description}. Logs: {self.run_dir}")

    def cleanup(self):
        # Never stop existing services or remove the PostgreSQL volume.
        groups = [child.pid for _, child in self.children]
        for group in groups:
            try:
                os.killpg(group, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + 10
        for _, child in self.children:
            try:
                child.wait(timeout=max(0.1, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                pass
        # A parent may have exited before one of its children; inspect the group too.
        for group in groups:
            try:
                os.killpg(group, 0)
                os.killpg(group, signal.SIGKILL)
            except ProcessLookupError:
                pass
        for _, child in self.children:
            child.wait()
        for log in self.log_handles:
            log.close()

    def start(self):
        for command in ("docker", "go", "bun"):
            if not shutil.which(command):
                raise StartupError(f"Install {command} before running sent-start.")
        result = subprocess.run(["docker", "compose", "version"], capture_output=True)
        if result.returncode:
            raise StartupError("Docker Compose is unavailable. Install/start Docker Desktop.")
        for port in (self.args.console_port, self.args.gateway_port):
            require_free_port(port)
        if self.args.console_port == self.args.gateway_port:
            raise StartupError("Console and gateway ports must be different.")
        if self.args.check:
            print("Prerequisites found; console and gateway ports are available.")
            return

        os.umask(0o077)
        base = Path.home() / ".local" / "share" / "sentinel" / "runs"
        base.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.run_dir = Path(tempfile.mkdtemp(prefix=datetime.now().strftime("%Y%m%d-%H%M%S-"), dir=base))
        print(f"Starting Sentinel. Logs: {self.run_dir}", flush=True)

        if not docker_ready():
            if sys.platform == "darwin":
                print("Opening Docker Desktop…", flush=True)
                self.run_command(["open", "-a", "Docker"])
            else:
                raise StartupError("Start the Docker daemon, then run sent-start again.")
            self.wait_for("Docker Desktop", docker_ready)

        print("Starting PostgreSQL, NATS and behavioural analytics…", flush=True)
        self.run_command(["docker", "compose", "up", "-d", "--build"], log_name="infrastructure")
        self.wait_for("PostgreSQL", postgres_ready)
        self.wait_for("NATS", lambda: http_ready("http://127.0.0.1:8222/healthz"))
        self.wait_for("ML service", lambda: http_ready("http://127.0.0.1:8090/health"))

        print("Checking frontend dependencies and building the gateway…", flush=True)
        self.run_command(["bun", "install", "--frozen-lockfile"], cwd=ROOT / "apps" / "console")
        binary = self.run_dir / "sentinel-gateway"
        self.run_command(["go", "build", "-o", str(binary), "./cmd/gateway"], cwd=ROOT / "services" / "gateway")

        result = subprocess.run([sys.executable, str(ROOT / "scripts" / "provision-lab-console-auth.py")],
                                cwd=ROOT, capture_output=True, text=True, check=True)
        credentials = json.loads(result.stdout)
        env = os.environ.copy()
        env.update(SENTINEL_AUTH_MODE="required", SENTINEL_CONSOLE_AUTH_MODE="required",
                   SENTINEL_AUTH_CREDENTIALS_FILE=credentials["manifest_path"],
                   SENTINEL_CONSOLE_ORIGIN=self.console_url,
                   SENTINEL_HTTP_ADDR=f"127.0.0.1:{self.args.gateway_port}",
                   SENTINEL_GATEWAY_URL=self.gateway_url, SENTINEL_BEHAVIOUR_ENABLED="true")
        print("Starting authenticated gateway…", flush=True)
        self.spawn([str(binary)], env, "gateway")
        self.wait_for("gateway readiness", lambda: http_ready(self.gateway_url + "/ready"))
        print("Starting analyst console…", flush=True)
        self.spawn(["bun", "run", "dev", "--port", str(self.args.console_port)], env, "console",
                   cwd=ROOT / "apps" / "console")
        self.wait_for("console", lambda: http_ready(self.console_url + "/sign-in"), timeout=180)
        print(f"\nSentinel is ready: {self.console_url}/sign-in\n"
              f"Credential file: {credentials['token_file_path']}\n"
              f"Credentials expire: {credentials['expires_at']}\n"
              "Use the analyst credential from that file to sign in.\n"
              "Press Ctrl-C to stop the gateway and console. Docker services and data remain available.", flush=True)
        if self.args.copy_token:
            if sys.platform != "darwin" or not shutil.which("pbcopy"):
                print("Clipboard copying is unavailable; use the credential file.", flush=True)
            else:
                tokens = json.loads(Path(credentials["token_file_path"]).read_text())
                subprocess.run(["pbcopy"], input=tokens["tokens"]["analyst"], text=True, check=True)
                print("Analyst credential copied to the clipboard; paste it into sign-in.", flush=True)
        if not self.args.no_browser:
            webbrowser.open(self.console_url + "/sign-in")
        while True:
            self.check_children()
            time.sleep(1)


def require_free_port(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        try:
            sock.bind(("127.0.0.1", port))
        except OSError as error:
            raise StartupError(f"Port {port} is already in use. Stop its existing service before starting Sentinel.") from error


def docker_ready():
    try:
        return subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def postgres_ready():
    try:
        return subprocess.run(["docker", "compose", "exec", "-T", "postgres", "sh", "-c",
                               'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"'],
                              cwd=ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=10).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def http_ready(url):
    try:
        with urlopen(url, timeout=3) as response:
            return response.status == 200
    except (URLError, TimeoutError, OSError):
        return False


def port_number(value):
    port = int(value)
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--no-browser", action="store_true", help="do not open the browser")
    parser.add_argument("--copy-token", action="store_true", help="copy the analyst credential to the macOS clipboard")
    parser.add_argument("--check", action="store_true", help="check prerequisites and ports without starting services")
    parser.add_argument("--console-port", type=port_number, default=3000)
    parser.add_argument("--gateway-port", type=port_number, default=8080)
    launcher = Launcher(parser.parse_args())
    def stop(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    try:
        launcher.start()
    except KeyboardInterrupt:
        print("\nStopping Sentinel…", flush=True)
    except (StartupError, subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
        print(f"sent-start: {error}", file=sys.stderr)
        return 1
    finally:
        launcher.cleanup()
    return 0


if __name__ == "__main__":
    sys.exit(main())
