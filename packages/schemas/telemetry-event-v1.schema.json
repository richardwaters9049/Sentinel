{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/telemetry-event-v1.schema.json",
  "title": "Sentinel Normalised Telemetry Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "timestamp",
    "received_at",
    "source",
    "event"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "labels": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "collector"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "vendor": {
          "type": "string",
          "maxLength": 128
        },
        "collector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hostname", "zone"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "zone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "action"],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip": {
          "type": "string"
        },
        "destination_ip": {
          "type": "string"
        },
        "destination_port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "destination_zone": {
          "type": "string",
          "maxLength": 64
        },
        "protocol": {
          "type": "string",
          "maxLength": 32
        }
      }
    }
  }
}
