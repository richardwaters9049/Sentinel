FROM golang:1.27.2-alpine@sha256:85dc1069ac644ea3c527b177303a406eb3358192816cd7f9e5848eb658851673 AS build
ENV CGO_ENABLED=0 GOWORK=off GOFLAGS=-p=2
RUN go install go.opentelemetry.io/collector/cmd/builder@v0.162.0
COPY otel-builder.yaml /build/manifest.yaml
RUN /go/bin/builder --config=/build/manifest.yaml
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /build/collector/sentinel-otel /otelcol-contrib
USER 10001:10001
ENTRYPOINT ["/otelcol-contrib"]
